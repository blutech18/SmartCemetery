# Smart Cemetery Platform — Environment Variables
# Copy this file to .env.local and fill in your values

# Database — MySQL connection string
DATABASE_URL="mysql://root:password@localhost:3306/cemetery_map"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Leaflet tile provider — required in production
# Use a managed provider or self-hosted tiles. Include the provider-required
# attribution text. Public OpenStreetMap tiles are a development fallback only.
NEXT_PUBLIC_MAP_TILE_URL="https://your-tile-provider.example/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="Map data and imagery attribution"

# AES-256 Encryption Key (32 bytes hex)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Map center — configurable default coordinates for the cemetery map (Req 13.1)
# If unset, invalid, non-numeric, out of range, or partial, the app falls back
# to the documented default center (8.4647, 124.6578).
# Valid ranges: MAP_CENTER_LAT [-90..90], MAP_CENTER_LNG [-180..180]
MAP_CENTER_LAT="8.4647"
MAP_CENTER_LNG="124.6578"

# Client-exposed map center (Req 13.4). The Leaflet map components run in the
# browser, so the center must be exposed via NEXT_PUBLIC_ prefixed variables
# (inlined at build time). Keep these in sync with MAP_CENTER_LAT/LNG above.
# If unset, invalid, non-numeric, out of range, or partial, the map falls back
# to the documented default center (8.4647, 124.6578).
NEXT_PUBLIC_MAP_CENTER_LAT="8.4647"
NEXT_PUBLIC_MAP_CENTER_LNG="124.6578"

# Cemetery-specific pedestrian routing — required in production (Req 12)
# Point this at a managed or self-hosted OSRM-compatible service built from the
# cemetery's walkable path graph. Public OSRM is development-only.
ROUTING_BASE_URL="https://routing.example.gov.ph"
ROUTING_PROFILE="foot"

# Client-exposed endpoint used by NavigationOverlay. Keep these values aligned
# with the server settings. Provider credentials must not be embedded here.
NEXT_PUBLIC_ROUTING_BASE_URL="https://routing.example.gov.ph"
NEXT_PUBLIC_ROUTING_PROFILE="foot"

# Scheduled archival credential (Req 6.6)
# Required for scheduled/cron-triggered archival. The POST /api/archival endpoint
# accepts requests whose `x-archival-token` header matches this value.
ARCHIVAL_CRON_SECRET="change-this-archival-cron-secret"
# Optional: user id used as the audit actor for cron-triggered archival, since
# the scheduled path has no user session (UserLog.userId is a required FK).
# When unset, cron-triggered archival records its outcome via a server log.
ARCHIVAL_SYSTEM_USER_ID=""

# Email notifications (SMTP) — optional (Req 9.3)
# When left unset, notifications are delivered in-app only. Set all SMTP_* values
# and EMAIL_FROM to enable outbound email notifications.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Smart Cemetery <no-reply@example.com>"
